{
  "name": "fquiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fast-paced Flash Quiz for university classrooms",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "frontend"
